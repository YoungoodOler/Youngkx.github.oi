{
  "name": "youngkx-digital-garden",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "node scripts/clean.mjs",
    "check": "tsc --noEmit && tsc -p cloudflare/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config config/vitest.config.mts",
    "test:watch": "vitest --config config/vitest.config.mts",
    "preview:test": "wrangler dev --local --port 8787 --local-upstream www.youngkx.cn --log-level error",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "perf:check": "node scripts/check-performance-budget.mjs",
    "worker:types": "wrangler types cloudflare/worker-configuration.d.ts",
    "validate": "npm run check && npm run lint && npm run test && npm run build && npm run perf:check",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "framer-motion": "^12.23.9",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.7",
    "next": "15.5.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "prettier": "3.9.6",
    "typescript": "^5.8.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260730.1": true
  }
}
