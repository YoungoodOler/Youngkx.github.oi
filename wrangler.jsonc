{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youngkxblog",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./cloudflare/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "youngkx.cn",
      "custom_domain": true,
    },
    {
      "pattern": "www.youngkx.cn",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "9be5bcf408694c938a53af6a61d42b85",
    },
  ],
  "d1_databases": [
    {
      "binding": "ARTICLE_INTERACTIONS",
      "database_name": "youngkx-article-interactions",
      "database_id": "d361a700-9895-4adb-9db1-60b4232c32b7",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "youngkx-files",
    },
  ],
  "secrets": {
    "required": ["LINKS_ADMIN_TOKEN"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.01,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
